# Variables del setup de Unity Catalog. Copia este archivo a wizardbank.env y completa los valores.
# wizardbank.env está en .gitignore: nunca se versiona.
# El client secret NO va aquí: exporta WIZARDBANK_SP_CLIENT_SECRET en la terminal o deja que el script lo pida.

# --- Workspace de Databricks (perfil de ~/.databrickscfg autenticado con `databricks auth login`) ---
DATABRICKS_CONFIG_PROFILE=giancarlo92

# --- Service Principal de Azure (lo entrega Terraform) ---
WIZARDBANK_TENANT_ID=
WIZARDBANK_SP_CLIENT_ID=

# --- ADLS Gen2 ---
WIZARDBANK_STORAGE_ACCOUNT=dbwizarduniquelab
WIZARDBANK_LANDING_CONTAINER=landing
WIZARDBANK_CHECKPOINT_CONTAINER=checkpoint

# --- Nombres de los objetos en Unity Catalog ---
WIZARDBANK_CREDENTIAL_NAME=azure_adls_wizardbank_credential
WIZARDBANK_LANDING_LOCATION_NAME=azure_adls_landing_location
WIZARDBANK_CHECKPOINT_LOCATION_NAME=azure_adls_checkpoint_location

# --- Opcional: SQL warehouse para la prueba final LIST sobre cada ruta ---
WIZARDBANK_WAREHOUSE_ID=
